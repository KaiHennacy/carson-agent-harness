# Required runtime configuration.
# Supply values appropriate for the Termux device.
CARSON_DOWNLOAD_DIR=/path/to/android/downloads
CARSON_A_DIR=/path/to/llm-outbox-a
CARSON_B_DIR=/path/to/llm-archive-b

# Optional. If omitted, the installer generates a unique instance ID
# and places state beneath the user's Termux home directory.
# CARSON_INSTANCE_ID=...
# CARSON_STATE_ROOT=...
